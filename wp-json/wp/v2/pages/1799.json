\t\t\t<div class=\"elementor-element elementor-element-afgmn53 elementor-widget elementor-widget-text-editor\" data-id=\"afgmn53\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p style=\"color:#DE8864;letter-spacing:4px;text-transform:uppercase;font-size:11px;font-weight:600;margin:0 0 8px 0;\">The application<\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-afhrfue elementor-widget elementor-widget-spacer\" data-id=\"afhrfue\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"spacer.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<div class=\"elementor-spacer\">\n\t\t\t<div class=\"elementor-spacer-inner\"><\/div>\n\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-citrusformhtml elementor-widget elementor-widget-text-editor\" data-id=\"citrusformhtml\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<style>\n#citrus-form{font-family:inherit;}\n#citrus-form .cf-field{margin-bottom:24px;}\n#citrus-form label{display:block;color:#DE8864;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;font-weight:600;margin-bottom:8px;}\n#citrus-form input[type=text],#citrus-form input[type=email],#citrus-form input[type=tel],#citrus-form select,#citrus-form textarea{width:100%;background:transparent;border:none;border-bottom:1px solid rgba(245,240,232,0.35);color:#F5F0E8;font-size:15px;padding:10px 0;outline:none;font-family:inherit;border-radius:0;-webkit-appearance:none;appearance:none;}\n#citrus-form select{cursor:pointer;}\n#citrus-form select option{background:#14261C;color:#F5F0E8;}\n#citrus-form textarea{min-height:100px;resize:vertical;border:1px solid rgba(245,240,232,0.35);padding:10px;margin-top:2px;}\n#citrus-form input:focus,#citrus-form select:focus,#citrus-form textarea:focus{border-color:#DE8864;outline:none;}\n#citrus-form .cf-submit{margin-top:16px;}\n#citrus-form button[type=submit]{background:#DE8864;color:#14261C;border:none;font-size:14px;letter-spacing:0.1em;text-transform:uppercase;font-weight:700;padding:18px 48px;cursor:pointer;border-radius:0;font-family:inherit;}\n#citrus-form button[type=submit]:hover{background:#c97a55;}\n#citrus-form .cf-success{display:none;color:#F5F0E8;font-size:18px;line-height:1.8;padding:32px 0;}\n#citrus-form .cf-error{display:none;color:#DE8864;font-size:14px;margin-top:12px;}\n#citrus-form .cf-two{display:grid;grid-template-columns:1fr 1fr;gap:0 32px;}\n@media(max-width:600px){#citrus-form .cf-two{grid-template-columns:1fr;}}\n<\/style>\n<div id=\"citrus-form\">\n<div class=\"cf-success\"><p>Thank you for applying.<\/p><p>We review applications quarterly and will follow up within five business days.<\/p><\/div>\n<form id=\"citrus-advisory-form\">\n  <div class=\"cf-two\">\n    <div class=\"cf-field\"><label>First Name *<\/label><input type=\"text\" name=\"first_name\" required><\/div>\n    <div class=\"cf-field\"><label>Last Name *<\/label><input type=\"text\" name=\"last_name\" required><\/div>\n  <\/div>\n  <div class=\"cf-two\">\n    <div class=\"cf-field\"><label>Email Address *<\/label><input type=\"email\" name=\"email\" required><\/div>\n    <div class=\"cf-field\"><label>Phone Number<\/label><input type=\"tel\" name=\"phone\"><\/div>\n  <\/div>\n  <div class=\"cf-two\">\n    <div class=\"cf-field\"><label>Business Name *<\/label><input type=\"text\" name=\"business_name\" required><\/div>\n    <div class=\"cf-field\"><label>Industry *<\/label><input type=\"text\" name=\"industry\" required><\/div>\n  <\/div>\n  <div class=\"cf-two\">\n    <div class=\"cf-field\"><label>Years in Business<\/label><input type=\"text\" name=\"years_in_business\"><\/div>\n    <div class=\"cf-field\"><label>Annual Revenue (approximate)<\/label>\n      <select name=\"annual_revenue\">\n        <option value=\"\">Select&#8230;<\/option>\n        <option>Under $500K<\/option><option>$500K &#8211; $1M<\/option><option>$1M &#8211; $5M<\/option>\n        <option>$5M &#8211; $10M<\/option><option>Over $10M<\/option><option>Prefer not to say<\/option>\n      <\/select>\n    <\/div>\n  <\/div>\n  <div class=\"cf-field\"><label>What is your primary challenge right now? *<\/label><textarea name=\"primary_challenge\" required><\/textarea><\/div>\n  <div class=\"cf-field\"><label>What do you want to achieve in the next 12 months? *<\/label><textarea name=\"goals_12_month\" required><\/textarea><\/div>\n  <div class=\"cf-field\"><label>Are you open to a minimum six-month engagement? *<\/label>\n    <select name=\"six_month\" required>\n      <option value=\"\">Select&#8230;<\/option>\n      <option>Yes<\/option><option>No<\/option><option>I need more information first<\/option>\n    <\/select>\n  <\/div>\n  <div class=\"cf-two\">\n    <div class=\"cf-field\"><label>How did you hear about Signature Advisory?<\/label>\n      <select name=\"how_heard\">\n        <option value=\"\">Select&#8230;<\/option>\n        <option>Referral<\/option><option>LinkedIn<\/option><option>Website search<\/option>\n        <option>Social media<\/option><option>Other<\/option>\n      <\/select>\n    <\/div>\n    <div><\/div>\n  <\/div>\n  <div class=\"cf-field\"><label>Anything else you would like us to know?<\/label><textarea name=\"additional_notes\"><\/textarea><\/div>\n  <div class=\"cf-submit\"><button type=\"submit\">Submit Application<\/button><\/div>\n  <div class=\"cf-error\">Something went wrong. Please email us directly at hello@citruscapital.ca<\/div>\n<\/form>\n<\/div>\n<script>\ndocument.getElementById('citrus-advisory-form').addEventListener('submit', function(e) {\n  e.preventDefault();\n  var form = this;\n  var btn = form.querySelector('button[type=submit]');\n  btn.textContent = 'Sending...';\n  btn.disabled = true;\n  var fd = new FormData(form);\n  fd.append('action', 'citrus_advisory_form_submit');\n  fd.append('nonce', (typeof citrusFormData !== 'undefined') ? citrusFormData.nonce : '');\n  var name = (fd.get('first_name') || '') + ' ' + (fd.get('last_name') || '');\n  fd.append('name', name.trim());\n  fetch((typeof citrusFormData !== 'undefined') ? citrusFormData.ajaxurl : '\/wp-admin\/admin-ajax.php', {\n    method: 'POST',\n    body: fd\n  }).then(function(r){ return r.json(); }).then(function(res) {\n    if (res.success) {\n      form.style.display = 'none';\n      document.querySelector('.cf-success').style.display = 'block';\n    } else {\n      document.querySelector('.cf-error').style.display = 'block';\n      btn.textContent = 'Submit Application';\n      btn.disabled = false;\n    }\n  }).catch(function() {\n    document.querySelector('.cf-error').style.display = 'block';\n    btn.textContent = 'Submit Application';\n    btn.disabled = false;\n  });\n});\n<\/script>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":"","protected":false},"author":7,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"elementor_header_footer","meta":{"site-sidebar-layout":"default","site-content-layout":"","ast-site-content-layout":"default","site-content-style":"default","site-sidebar-style":"default","ast-global-header-display":"","ast-banner-title-visibility":"","ast-main-header-display":"","ast-hfb-above-header-display":"","ast-hfb-below-header-display":"","ast-hfb-mobile-header-display":"","site-post-title":"","ast-breadcrumbs-content":"","ast-featured-img":"","footer-sml-layout":"","ast-disable-related-posts":"","theme-transparent-header-meta":"","adv-header-id-meta":"","stick-header-meta":"","header-above-stick-meta":"","header-main-stick-meta":"","header-below